[Unit]
Description=My Websites static page
After=network.target

[Service]
Type=simple
User=charles
WorkingDirectory=/home/charles/git/media_management/media_manager_frontend
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/home/linuxbrew/.linuxbrew/bin/python3 -m http.server 80 --bind 0.0.0.0 --directory /home/charles/git/media_management/media_manager_frontend/websites
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
